{
  "expo": {
    "name": "AirGuard",
    "slug": "airguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "airguard",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.airguard.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.airguard.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-cloud.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "AirGuard uses the camera to scan the QR code on your sensor node.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "icon": "./assets/icon-cloud.png"
  }
}
